PORT=4173
HOST=127.0.0.1
DATABASE_PATH=./data/kantin.sqlite
# Production'da tam origin listesi: https://kantin.example.com
ALLOWED_ORIGINS=

# Supabase proje ayarlari. Gizli degerleri yalnizca .env.local veya Vercel'de tutun.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Ödüllü reklam doğrulaması. Service-role anahtarı yalnız Vercel sunucu ortamında tutulur.
SUPABASE_SERVICE_ROLE_KEY=
REWARDED_AD_PROVIDER=admob
ADMOB_REWARDED_AD_UNIT_ID_ANDROID=
ADMOB_REWARDED_AD_UNIT_ID_IOS=
# Yalnız preview/local geliştirme ortamında kullanın; production'da kod tarafından kapatılır.
REWARDED_AD_TEST_MODE=false
